# Copy this file to .env or export these variables in your shell.
# Scripts do not automatically load .env; your Agent or shell must export them.

# Required: absolute path to your Obsidian vault.
OBSIDIAN_VAULT="/absolute/path/to/your/ObsidianVault"

# Optional: generated note folder inside the vault.
MIAOJI_NOTE_FOLDER="40 Resources/录音转写"

# Optional: converted MP3 folder inside the vault.
MIAOJI_AUDIO_FOLDER="40 Resources/附件/录音原件"
