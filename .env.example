# Copy this file to .env or export these variables in your shell.
# Scripts do not automatically load .env; your Agent or shell must export them.

# Required: absolute path to your Obsidian vault.
OBSIDIAN_VAULT="/absolute/path/to/your/ObsidianVault"

# Optional: source package root inside the vault.
MIAOJI_SOURCE_FOLDER="40 Resources/源料库"

# Optional: set this only if you want audio outside the source package assets folder.
# By default, each recording MP3 is saved to:
# 40 Resources/源料库/<recording-title>/assets/
# MIAOJI_AUDIO_FOLDER="your/shared/audio/folder"
